# Copy this file to .env (gitignored) and fill in real values for local dev.

# Google Calendar API key used by /calendar. Not a secret — it's restricted
# by HTTP referrer + API scope in Google Cloud Console — but still kept out
# of git so each machine/environment sets its own. See SITE-TODO.md.
GOOGLE_CALENDAR_API_KEY=

# Base URL of the PocketBase instance behind /padron (see padron-backend/).
# Local dev: http://127.0.0.1:8090
PADRON_API_URL=
